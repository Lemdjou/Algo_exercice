# Configuration Générale AdVision
NODE_ENV=development
PORT=3000

# Base de Données PostgreSQL
POSTGRES_DB=advision_db
POSTGRES_USER=advision_user
POSTGRES_PASSWORD=advision_password_secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Securite JWT
JWT_SECRET=advision_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# Configuration Diffusion / Publicite
DEFAULT_AD_DURATION=30
GLOBAL_TIMEOUT_MINUTES=3
